{
  "expo": {
    "name": "Gestión de Títulos",
    "slug": "titulos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "titulosapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2E5A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.edu.titulosapp",
      "infoPlist": {
        "NSCameraUsageDescription": "La aplicación necesita acceso a la cámara para fotografiar los títulos académicos.",
        "NSPhotoLibraryUsageDescription": "La aplicación necesita acceso a la galería para seleccionar imágenes de títulos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1A2E5A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.edu.titulosapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite el acceso a la cámara para fotografiar títulos académicos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar imágenes de la galería."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ada3a21b-afec-471c-af08-9fd72c55c4a6"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ada3a21b-afec-471c-af08-9fd72c55c4a6"
    }
  }
}
